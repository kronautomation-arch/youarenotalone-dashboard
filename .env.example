# === SHOPIFY ===
# Subdominio antes de .myshopify.com (ej: si la tienda es algo.myshopify.com -> SHOPIFY_STORE=algo)
SHOPIFY_STORE=youarenotalone
# Admin API token (Custom App). Scopes minimos: read_orders, read_products
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === META ADS ===
# Token de larga duracion (60 dias) generado en Graph API Explorer con permiso ads_read
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cuentas publicitarias separadas por coma (formato act_xxxxxxxxx)
META_ACCOUNT_IDS=act_111111111,act_222222222
# Opcional - para auto-renovacion de token
META_APP_ID=
META_APP_SECRET=

# === SEO (DataForSEO via seo-system) ===
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SEO_DOMAIN=youarenotalone.es
SEO_LOCATION_CODE=2724
SEO_LANGUAGE=es

# === DEPLOY ===
GITHUB_TOKEN=
GITHUB_REPO=kronautomation/youarenotalone-dashboard
